      </div>
    </section>

  </main>
</SiteLayout>

<script>
  (function () {
    // Without this script Watch the demo is a plain link to the video on
    // YouTube. With it, the video plays in a lightbox, and closing the
    // lightbox (Close, Escape, or a click outside the video) unloads it.
    var demo = document.getElementById('demo');
    var player = demo.querySelector('iframe');
    document.querySelectorAll('[data-demo]').forEach(function (link) {
      link.addEventListener('click', function (event) {
        event.preventDefault();
        player.src = player.getAttribute('data-src');
        demo.showModal();
      });
    });
    demo.addEventListener('click', function (event) {
      if (event.target === demo) demo.close();
    });
    demo.addEventListener('close', function () {
      player.src = 'about:blank';
    });

    // Without this script a screenshot is a plain link to its image. With it,
    // the image opens in a lightbox, fitted to it. Close, Escape, a click
    // outside the image, or Back closes the lightbox.
    var lightbox = document.getElementById('screenshot');
    var view = lightbox.querySelector('.shot-view');
    var full = view.querySelector('img');
    document.querySelectorAll('.shot a[href$=".png"]').forEach(function (link) {
      link.addEventListener('click', function (event) {
        event.preventDefault();
        full.alt = link.querySelector('img').alt;
        full.src = link.getAttribute('href');
        lightbox.showModal();
        history.pushState({ screenshot: true }, '');
      });
    });
    lightbox.addEventListener('click', function (event) {
      if (event.target === lightbox || event.target === view) lightbox.close();
    });
    lightbox.addEventListener('close', function () {
      if (history.state && history.state.screenshot) history.back();
    });
    window.addEventListener('popstate', function () {
      if (lightbox.open) lightbox.close();
    });

    // Without this script the install command has no Copy button.
    document.querySelectorAll('[data-copy]').forEach(function (button) {
      if (!navigator.clipboard) return;
      button.hidden = false;
      button.addEventListener('click', function () {
        navigator.clipboard.writeText(button.getAttribute('data-copy')).then(function () {
          button.classList.add('copied');
          button.setAttribute('aria-label', 'Copied');
          setTimeout(function () {
            button.classList.remove('copied');
            button.setAttribute('aria-label', 'Copy the command');
          }, 1500);
        });
      });
    });

    // Without this script every report panel and every answer shows, one
    // under the other.
    document.querySelectorAll('[data-tabs]').forEach(function (tabs) {
      tabs.setAttribute('data-tabs', 'ready');
      var buttons = Array.prototype.slice.call(tabs.querySelectorAll('[role=tab]'));
      function select(selected) {
        buttons.forEach(function (button) {
          var on = button === selected;
          button.setAttribute('aria-selected', String(on));
          button.tabIndex = on ? 0 : -1;
          document.getElementById(button.getAttribute('aria-controls')).hidden = !on;
        });
      }
      buttons.forEach(function (button, i) {
        button.addEventListener('click', function () { select(button); });
        button.addEventListener('keydown', function (event) {
          // The questions stack and the reports run across, so both pairs
          // of arrows move between them.
          var step = event.key === 'ArrowDown' || event.key === 'ArrowRight' ? 1
            : event.key === 'ArrowUp' || event.key === 'ArrowLeft' ? -1 : 0;
          if (!step) return;
          var next = buttons[(i + step + buttons.length) % buttons.length];
          select(next);
          next.focus();
        });
      });
      select(buttons[0]);
    });
  })();
</script>
