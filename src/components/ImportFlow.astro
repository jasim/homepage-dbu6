---
// The agent writing a parser for a bank's statement, drawn in the desk
// engraving's ink: the statement on the left, and the parser the agent wrote
// for it on the right. Each paper is white with a hatched shadow, like the
// engraving's objects; the ink is currentColor (--g-ink), and the colour is
// the agent's work: the columns it found on the statement, and the names it
// gave them in the parser, each in the column's colour.
// The statement's lines, as the engraving would draw print too small to
// read: a date, a narration of some length, and an amount.
const statementLines = [44, 30, 40, 26, 36, 42];
// The columns the agent found on the statement, each in its own colour.
const columns = [
  { name: "DATE", x: 11, width: 28, colour: "#2f7480" },
  { name: "PAYEE", x: 42, width: 50, colour: "#4f5b9c" },
  { name: "AMOUNT", x: 102, width: 38, colour: "#c2410c" },
];
const [date, payee, amount] = columns.map((column) => column.colour);
// The parser, as it would read: each line its runs of text, a run's colour
// if it names a column, and the character it starts at when it's aligned.
const charWidth = 4.64; // the mono font at 7.5px
type Run = { text: string; colour?: string; at?: number };
const code: { x: number; runs: Run[] }[] = [
  { x: 12, runs: [{ text: "def parse(line):" }] },
  { x: 20, runs: [{ text: "date", colour: date }, { text: "= line[0:9]", at: 7 }] },
  { x: 20, runs: [{ text: "payee", colour: payee }, { text: "= line[10:42]", at: 7 }] },
  { x: 20, runs: [{ text: "amount", colour: amount }, { text: "= line[-12:]", at: 7 }] },
  { x: 20, runs: [{ text: "return " }, { text: "date", colour: date }, { text: ", " }, { text: "payee", colour: payee }, { text: ", " }, { text: "amount", colour: amount }] },
];
const codeLines = code.map((line, i) => ({
  ...line,
  runs: line.runs.map((run) => ({ ...run, x: run.at === undefined ? undefined : line.x + run.at * charWidth })),
  y: 48 + i * 16,
}));
---
<figure class="import-flow">
  <svg viewBox="0 0 450 280" role="img" aria-labelledby="import-flow-title">
    <title id="import-flow-title">A PDF statement from a bank dbu6 hasn't seen before. Your coding agent reads it, finds its date, payee and amount columns, and writes a parser that reads them, which dbu6 saves for that bank's next statements.</title>
    <defs>
      <pattern id="flow-hatch" width="3.5" height="3.5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="3.5" stroke="currentColor" stroke-width="0.9" />
      </pattern>
      <pattern id="flow-hatch-light" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(-35)">
        <line x1="0" y1="0" x2="0" y2="4" stroke="currentColor" stroke-width="0.5" />
      </pattern>
      <pattern id="flow-stipple" width="5" height="5" patternUnits="userSpaceOnUse">
        <circle cx="1.2" cy="1.2" r="0.6" fill="currentColor" />
        <circle cx="3.7" cy="3.6" r="0.45" fill="currentColor" />
      </pattern>
      <marker id="flow-head" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="9" markerHeight="9" orient="auto-start-reverse" markerUnits="userSpaceOnUse">
        <path d="M1 1 L8.5 5 L1 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>

    <!-- The statement, with the columns the agent found on it -->
    <g transform="translate(24 40) rotate(-3)">
      <path class="shadow" d="M6 7 H130 L156 33 V197 H6 Z" />
      <path class="paper" d="M0 0 H124 L150 26 V190 H0 Z" />
      <path class="fold" d="M124 0 V26 H150" />
      <rect x="14" y="16" width="16" height="16" fill="url(#flow-hatch)" class="ink-edge" />
      <text x="38" y="26" class="flow-mono flow-tiny">STATEMENT</text>
      <text x="118" y="26" class="flow-mono flow-tiny" text-anchor="end">SEP</text>
      <line x1="38" y1="33" x2="96" y2="33" class="hair" />
      {statementLines.map((width, i) => (
        <g class="print">
          <line x1="14" y1={62 + i * 16} x2="36" y2={62 + i * 16} />
          <line x1="44" y1={62 + i * 16} x2={44 + width} y2={62 + i * 16} />
          <line x1={116 - (i % 3) * 6} y1={62 + i * 16} x2="136" y2={62 + i * 16} />
        </g>
      ))}
      {columns.map((column) => (
        <g style={`color: ${column.colour}`}>
          <rect x={column.x} y="55" width={column.width} height="94" rx="2" class="flow-column" />
          <path d={`M${column.x} 53 V49 H${column.x + column.width} V53`} class="flow-bracket" />
          <text x={column.x + column.width / 2} y="45" class="flow-mono flow-column-name" text-anchor="middle">{column.name}</text>
        </g>
      ))}
      <rect x="14" y="160" width="34" height="16" rx="2" fill="currentColor" />
      <text x="31" y="171.5" class="flow-mono flow-tiny flow-on-ink" text-anchor="middle">PDF</text>
    </g>
    <text x="104" y="246" class="flow-label" text-anchor="middle">STATEMENT</text>

    <!-- The agent writes the parser, with a line for each column -->
    <path class="flow-line" d="M192 136 C214 128 238 128 262 134" marker-end="url(#flow-head)" />
    <g transform="translate(276 48) rotate(2.5)">
      <path class="shadow" d="M6 7 H134 L158 31 V171 H6 Z" />
      <path class="paper" d="M0 0 H128 L152 24 V164 H0 Z" />
      <path class="fold" d="M128 0 V24 H152" />
      <text x="12" y="18" class="flow-mono flow-tiny">hdfc.py</text>
      <text x="122" y="18" class="flow-mono flow-tiny flow-accent" text-anchor="end">saved ✓</text>
      <line x1="12" y1="25" x2="58" y2="25" class="hair" />
      {codeLines.map((line) => (
        <!-- On one line: the code keeps its spaces, so any between the tags would show -->
        <text x={line.x} y={line.y} class="flow-mono flow-code">{line.runs.map((run) => <tspan x={run.x} fill={run.colour}>{run.text}</tspan>)}</text>
      ))}
    </g>
    <text x="352" y="246" class="flow-label" text-anchor="middle">AGENT WRITES</text>
    <text x="352" y="262" class="flow-label" text-anchor="middle">A PARSER</text>
  </svg>
</figure>

<style>
  .import-flow {
    color: var(--g-ink);
    margin: 0;
    width: 100%;
  }

  .import-flow svg {
    display: block;
    height: auto;
    max-width: 36rem;
    overflow: visible;
    width: 100%;
  }

  .paper {
    fill: #fff;
    stroke: currentColor;
    stroke-linejoin: round;
    stroke-width: 1.4;
  }

  .shadow {
    fill: url(#flow-hatch-light);
  }

  .fold {
    fill: url(#flow-stipple);
    stroke: currentColor;
    stroke-linejoin: round;
    stroke-width: 1.2;
  }

  .ink-edge {
    stroke: currentColor;
    stroke-width: 1;
  }

  .hair {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.6;
  }


  .print line {
    stroke: currentColor;
    stroke-dasharray: 3 1.2 6 1;
    stroke-linecap: round;
    stroke-width: 1.6;
  }

  .flow-column {
    fill: currentColor;
    fill-opacity: 0.08;
    stroke: currentColor;
    stroke-dasharray: 2 2;
    stroke-opacity: 0.6;
    stroke-width: 0.8;
  }

  .flow-bracket {
    fill: none;
    stroke: currentColor;
    stroke-linejoin: round;
    stroke-width: 1.2;
  }

  .flow-column-name {
    font-size: 6.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .flow-code {
    font-size: 7.5px;
    white-space: pre;
  }

  .flow-accent {
    color: var(--ember);
  }

  .flow-line {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.6;
  }


  text {
    fill: currentColor;
  }

  .flow-label {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }



  .flow-mono {
    font-family: var(--font-mono);
  }

  .flow-tiny {
    font-size: 8.5px;
    letter-spacing: 0.08em;
  }




  .flow-on-ink {
    fill: #fff;
  }





</style>
